import java.util.Stack;

import java.util.LinkedList;

public class Assignment9 {
    public static void main(String[] args) {
        Stack<Integer> stax = new Stack<>();
        
        stax.push(70);
        stax.push(34);
        stax.push(807);
        stax.push(61);
        stax.push(28);
        stax.push(563);
        stax.push(492);
        stax.push(386);
        
        int max = 0;
        int min = 1000;
        for(int i = 0; i < stax.size(); i++){
            if(stax.peek() > max){
                max = stax.peek();
            }
            if(stax.peek() < min){
                min = stax.peek();
            }
        }
        System.out.println("The maximum value is " + max);
        System.out.println("The minimum value is " + min);
        System.out.println("There are " + stax.size() + " elements in the stack.");
        
        LinkedList<Integer> linky = new LinkedList<>();

        linky.add(10);
        linky.add(20);
        linky.add(30);
        linky.add(40);
        linky.add(50);

        int mid = linky.get(linky.size() / 2);
        System.out.println("The middle value is " + mid);

        
    }
}
